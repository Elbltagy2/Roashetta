# Roashetta Server Configuration (SQLite Version)
# Copy this file to .env and update the values

# Server
PORT=3000

# Database (SQLite - file path, leave empty for default 'roashetta.db')
# DATABASE_PATH=./roashetta.db

# JWT Secret (generate a random string - CHANGE THIS!)
JWT_SECRET=your-secret-key-here-change-this

# CORS (for local network, use *)
CORS_ORIGIN=*

# File Storage (local folder for patient records)
UPLOAD_PATH=./uploads
