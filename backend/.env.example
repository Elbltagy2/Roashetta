# Server
PORT=3000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your-secret-key-here-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Origins (comma-separated)
# Use * to allow all origins, or specify allowed origins
CORS_ORIGIN=*

# Auto-open browser when server starts (true/false)
AUTO_OPEN_BROWSER=false
