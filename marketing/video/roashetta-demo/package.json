{
  "name": "roashetta-demo-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "9:16 vertical product demo for Roashetta — Hyperframes composition (AR voiceover)",
  "scripts": {
    "placeholders": "bash make-placeholders.sh",
    "dev": "hyperframes preview",
    "check": "hyperframes lint . --verbose",
    "render": "hyperframes render . -o out/roashetta-demo-ar.mp4 -f 30 -q high --video-frame-format png",
    "render:draft": "hyperframes render . -o out/draft.mp4 -f 30 -q draft"
  },
  "dependencies": {
    "hyperframes": "^0.6.106"
  }
}
